{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/user/.config/fastfetch/unit01.png",
    "width": 35,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "right": 5,
      "bottom": 2,
      "left": 3
    }
  },
  "display": {
    "brightColor": true,
    "separator": " \u279c ",
    "color": {
      "keys": "38;2;59;115;90",
      "title": "38;2;212;210;207",
      "output": "38;2;212;210;207",
      "separator": "38;2;136;29;44"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "fqdn": true,
      "color": {
        "user": "38;2;136;29;44",
        "at": "38;2;110;108;105",
        "host": "38;2;176;210;211"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;59;115;90",
      "format": "{2} {12}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;2;59;115;90",
      "format": "{version}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;59;115;90"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;2;59;115;90"
    },
    {
      "type": "command",
      "key": "Age",
      "keyColor": "38;2;59;115;90",
      "text": "s=$(stat -c %W /); n=$(date +%s); diff=$((n - s)); d=$((diff / 86400)); h=$(((diff % 86400) / 3600)); [ \"$d\" -eq 1 ] && ds=\"1 day\" || ds=\"$d days\"; [ \"$h\" -eq 1 ] && hs=\"1 hour\" || hs=\"$h hours\"; echo \"$ds, $hs\""
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;2;59;115;90"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "38;2;59;115;90"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;59;115;90"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "38;2;59;115;90",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;2;59;115;90"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
