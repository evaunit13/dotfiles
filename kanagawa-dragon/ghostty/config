background   = #141312
foreground   = #c5c9c5
cursor-color = #c8c093
cursor-text  = #141312
selection-background = #2d4f67
selection-foreground = #c5c9c5

palette = 0=#0d0c0c
palette = 1=#c4746e
palette = 2=#8a9a7b
palette = 3=#c4b28a
palette = 4=#8ba4b0
palette = 5=#a292a3
palette = 6=#8ea4a2
palette = 7=#c5c9c5
palette = 8=#7a8382
palette = 9=#e46876
palette = 10=#87a987
palette = 11=#e6c384
palette = 12=#7fb4ca
