{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.config/fastfetch/rei.txt",
    "padding": {
      "top": 0,
      "right": 3,
      "bottom": 0,
      "left": 1
    }
  },
  "display": {
    "brightColor": true,
    "separator": " \u279c ",
    "color": {
      "keys": "38;2;125;174;163",
      "title": "38;2;212;210;207"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "fqdn": true,
      "color": {
        "user": "38;2;212;210;207",
        "at": "38;2;110;108;105",
        "host": "38;2;212;210;207"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;125;174;163",
      "format": "{2} {12}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;2;125;174;163",
      "format": "Hewlett-Packard Notebook"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;125;174;163"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;2;125;174;163"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;2;125;174;163"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;2;125;174;163"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;125;174;163",
      "format": "11th Gen Intel ({4}-Core)"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "38;2;125;174;163",
      "format": "Intel Iris Xe"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;2;125;174;163",
      "format": "{1} / {2} (3200 MT/s)"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
