# Main background, frame, text
theme[main_bg]="#141312"
theme[main_fg]="#d4d2cf"
theme[title]="#faf8f5"
theme[hi_fg]="#7daea3"
theme[selected_bg]="#434240"
theme[selected_fg]="#faf8f5"
theme[inactive_fg]="#6e6c69"
theme[graph_text]="#d4d2cf"
theme[meter_bg]="#302f2d"
theme[proc_misc]="#7ba39d"

# Box borders
theme[cpu_box]="#77969a"
theme[mem_box]="#a78fa8"
theme[net_box]="#86a685"
theme[proc_box]="#cbb77d"
theme[div_line]="#6e6c69"

# Temperature graph (Green -> Yellow -> Red)
theme[temp_start]="#86a685"
theme[temp_mid]="#cbb77d"
theme[temp_end]="#ca7b86"

# CPU graph (Cyan -> Blue -> Magenta)
theme[cpu_start]="#7ba39d"
theme[cpu_mid]="#77969a"
theme[cpu_end]="#a78fa8"

# Free memory graph (Green -> Cyan)
theme[free_start]="#86a685"
theme[free_mid]="#8ec07c"
theme[free_end]="#7ba39d"

# Cached memory graph (Blue -> Magenta)
theme[cached_start]="#77969a"
theme[cached_mid]="#7daea3"
theme[cached_end]="#a78fa8"

# Available memory graph (Yellow -> Green)
theme[available_start]="#cbb77d"
theme[available_mid]="#8ec07c"
theme[available_end]="#86a685"

# Used memory graph (Yellow -> Red)
theme[used_start]="#cbb77d"
theme[used_mid]="#d79921"
theme[used_end]="#ca7b86"

# Download graph (Blue -> Cyan)
theme[download_start]="#77969a"
theme[download_mid]="#7daea3"
theme[download_end]="#89b48f"

# Upload graph (Green -> Yellow)
theme[upload_start]="#86a685"
theme[upload_mid]="#8ec07c"
theme[upload_end]="#cbb77d"

# Process box & bars (Magenta -> Red)
theme[process_start]="#a78fa8"
theme[process_mid]="#d3869b"
theme[process_end]="#ca7b86"
