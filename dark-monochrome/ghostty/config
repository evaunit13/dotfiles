background   = #1e1d1c
foreground   = #d4d2cf
cursor-color = #d4d2cf
cursor-text  = #1e1d1c
selection-background = #434240
selection-foreground = #d4d2cf
palette = 0=#302f2d
palette = 1=#ca7b86
palette = 2=#86a685
palette = 3=#cbb77d
palette = 4=#77969a
palette = 5=#a78fa8
palette = 6=#7ba39d
palette = 7=#d4d2cf
palette = 8=#6e6c69
palette = 9=#d97e8a
palette = 10=#8ec07c
palette = 11=#d79921
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b48f
palette = 15=#faf8f5
font-family  = JetBrains Mono
font-size    = 11
window-width  = 87
window-height = 22
window-padding-x = 10
window-padding-y = 5
cursor-style       = bar
cursor-style-blink = true
shell-integration  = detect
scrollback-limit   = 10000
copy-on-select     = clipboard
mouse-hide-while-typing = true
gtk-single-instance = true
quit-after-last-window-closed = false
confirm-close-surface = false
scrollbar = never
mouse-scroll-multiplier = discrete:1,precision:1

custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = always
