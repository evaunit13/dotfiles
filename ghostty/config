background   = #1e1d1c
foreground   = #d4d2cf
cursor-color = #d4d2cf
cursor-text  = #1e1d1c
selection-background = #434240
selection-foreground = #d4d2cf
palette = 0=#302f2d
palette = 1=#8a8a8a
palette = 2=#909090
palette = 3=#c5c5c5
palette = 4=#a0a0a0
palette = 5=#b5b5b5
palette = 6=#9a9a9a
palette = 7=#d4d2cf
palette = 8=#6e6c69
palette = 9=#8a8a8a
palette = 10=#909090
palette = 11=#c5c5c5
palette = 12=#a0a0a0
palette = 13=#b5b5b5
palette = 14=#9a9a9a
palette = 15=#faf8f5
font-family  = JetBrains Mono
font-size    = 11
window-width  = 87
window-height = 22
window-padding-x = 10
window-padding-y = 5
cursor-style       = bar
cursor-style-blink = true
shell-integration  = detect
scrollback-limit   = 10000
copy-on-select     = clipboard
mouse-hide-while-typing = true
gtk-single-instance = true
quit-after-last-window-closed = false
confirm-close-surface = false
scrollbar = never
mouse-scroll-multiplier = discrete:1,precision:1

custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = always
