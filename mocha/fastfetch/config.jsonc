{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.config/fastfetch/fed.txt",
    "padding": {
      "top": 1,
      "right": 2,
      "bottom": 0,
      "left": 2
    }
  },
  "general": {},
  "display": {
    "brightColor": "true",
    "separator": " ",
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────╮",
      "outputColor": "38;2;203;166;247"
    },
    {
      "type": "title",
      "fqdn": true,
      "key": "│    User",
      "keyColor": "38;2;203;166;247",
      "color": {
        "user": "white",
        "at": "white",
        "host": "white"
      }
    },
    {
      "type": "os",
      "key": "│      OS",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "host",
      "key": "│    Host",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "uptime",
      "key": "│  Uptime",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "packages",
      "key": "│Packages",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "shell",
      "key": "│   Shell",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "terminal",
      "key": "│Terminal",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯",
      "outputColor": "38;2;203;166;247"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────╮",
      "outputColor": "38;2;137;180;250"
    },
    {
      "type": "cpu",
      "key": "│     CPU",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "gpu",
      "key": "│     GPU",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "display",
      "key": "│   Video",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "sound",
      "key": "│   Sound",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "memory",
      "key": "│  Memory",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "swap",
      "key": "│    Swap",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "disk",
      "key": "│    Disk",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯",
      "outputColor": "38;2;137;180;250"
    },
    {
      "type": "colors",
      "paddingLeft": 6,
      "symbol": "circle"
    }
  ]
}
